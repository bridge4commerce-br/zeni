{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zeni Smart Content Global Missions",
  "type": "object",
  "required": [
    "version",
    "missions"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "priority",
          "support",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "domain": {
            "type": "string",
            "enum": [
              "self_care",
              "belongings",
              "meals",
              "study",
              "home_participation",
              "transitions",
              "life_skills",
              "digital"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "ageMin": {
            "type": "integer",
            "minimum": 0
          },
          "ageMax": {
            "type": "integer",
            "minimum": 0
          },
          "suggestedTimeGroup": {
            "type": "string",
            "enum": ["morning", "afternoon", "evening", "anytime"]
          },
          "suggestedRecurrence": {
            "type": "string",
            "enum": ["once", "daily", "weekdays", "weekends"]
          },
          "suggestedStars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "eligibleAsExtra": {
            "type": "boolean"
          },
          "requiresApprovalByDefault": {
            "type": "boolean"
          },
          "culturalRelevance": {
            "type": "string",
            "enum": [
              "global",
              "contextual"
            ]
          },
          "status": {
            "const": "approved"
          }
        }
      }
    }
  }
}
